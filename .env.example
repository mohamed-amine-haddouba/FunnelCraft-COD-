# =================================================================
# CodWorth - Production Environment Variables
# =================================================================

# Server & Port Configuration
PORT=3000
NODE_ENV=production

# AI Engine Configuration (OpenAI-compatible / Gemini / DeepSeek)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini

# Stripe Billing (Optional - for Pro subscription checkout)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# SMTP Configuration for Real 2FA OTP & Password Reset Email Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="CodWorth <no-reply@codworth.com>"

# Google OAuth 2.0 Configuration (Both Backend & Frontend must use your Google Client ID)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# PayPal Checkout Configuration (One-Time Payments)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Cloudflare Turnstile CAPTCHA Protection
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here


