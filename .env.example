# =================================================================
# CodWorth — Environment Variables (Names Only, No Secrets)
# =================================================================

# 1. Core Server & Owner Identity
PORT=
APP_URL=
APP_ORIGIN=
# Additional explicitly trusted sites for credentialed API requests, comma-separated full origins.
CORS_ALLOWED_ORIGINS=
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=

# 2. GitHub Actions Fine-Grained Deployment (Scoped to Actions on this repo only)
GITHUB_DEPLOY_PAT=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_WORKFLOW_ID=

# 3. SMTP Email Delivery (Password Recovery & 2FA OTP)
SMTP_HOST=
SMTP_SECURE=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_MAILER_CLIENT_ID=
GOOGLE_MAILER_CLIENT_SECRET=
GOOGLE_MAILER_REFRESH_TOKEN=
EMAIL_VERIFY_WELCOME=false
ADMIN_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# 4. Sandbox Environment Keys (Strictly isolated from Production)
SANDBOX_PAYPAL_CLIENT_ID=
SANDBOX_PAYPAL_CLIENT_SECRET=
SANDBOX_FACEBOOK_PIXEL_ID=
SANDBOX_TIKTOK_PIXEL_ID=
SANDBOX_GTM_CONTAINER_ID=
SANDBOX_OZONEXPRESS_API_KEY=
SANDBOX_CATHEDIS_API_KEY=
SANDBOX_SENDIT_API_KEY=
SANDBOX_DIGYLOG_API_KEY=
SANDBOX_AMANA_API_KEY=
SANDBOX_OTP_PROVIDER_KEY=

# 5. Production & Sandbox PayPal Environment Keys
# Always set explicitly. Staging uses sandbox; live requires deliberate opt-in.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
VITE_PAYPAL_CLIENT_ID=
PROD_FACEBOOK_PIXEL_ID=
PROD_TIKTOK_PIXEL_ID=
PROD_GTM_CONTAINER_ID=
PROD_OZONEXPRESS_API_KEY=
PROD_CATHEDIS_API_KEY=
PROD_SENDIT_API_KEY=
PROD_DIGYLOG_API_KEY=
PROD_AMANA_API_KEY=
PROD_OTP_PROVIDER_KEY=

# 6. Additional Platform Integrations
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL=
SANDBOX_JWT_SECRET=
SANDBOX_PORT=3002
SANDBOX_REQUIRE_2FA=true
# TEST/DEVELOPMENT ONLY; never populate a static 2FA code in production.
SANDBOX_2FA_PIN=
SANDBOX_OWNER_PASSWORD=
BYPASS_CAPTCHA=
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
STRIPE_SECRET_KEY=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=

# Card checkout uses server-configured Stripe recurring Price IDs and APP_ORIGIN.
# APP_ORIGIN must be HTTPS and match the active environment.
# APP_ORIGIN already appears in the Core section above.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=
# Comma-separated CIDRs of the reverse proxies you actually operate.
TRUSTED_PROXY_CIDRS=
# Enabling this in production exposes owner administration, including a real terminal.
ENABLE_OWNER_COCKPIT=false
